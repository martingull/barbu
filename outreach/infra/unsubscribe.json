{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Barbu outreach unsubscribe endpoint and retained shared suppression store",
  "Parameters": {
    "CodeBucket": { "Type": "String" },
    "CodeKey": { "Type": "String" }
  },
  "Resources": {
    "OptOuts": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{ "AttributeName": "pk", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "pk", "KeyType": "HASH" }],
        "SSESpecification": { "SSEEnabled": true },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true }
      }
    },
    "OperatorSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": { "Description": "Barbu outreach operator API key; never public or in Git", "GenerateSecretString": { "PasswordLength": 64, "ExcludePunctuation": true } }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": { "LogGroupName": "/aws/lambda/barbu-outreach-unsubscribe", "RetentionInDays": 14 }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [{ "PolicyName": "UnsubscribeOnly", "PolicyDocument": { "Version": "2012-10-17", "Statement": [
          { "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"], "Resource": { "Fn::GetAtt": ["OptOuts", "Arn"] } },
          { "Effect": "Allow", "Action": "secretsmanager:GetSecretValue", "Resource": { "Ref": "OperatorSecret" } },
          { "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["Logs", "Arn"] } }
        ] } }]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "barbu-outreach-unsubscribe",
        "Runtime": "nodejs22.x",
        "Handler": "handler.handler",
        "Role": { "Fn::GetAtt": ["Role", "Arn"] },
        "Code": { "S3Bucket": { "Ref": "CodeBucket" }, "S3Key": { "Ref": "CodeKey" } },
        "MemorySize": 128,
        "Timeout": 10,
        "ReservedConcurrentExecutions": 2,
        "Environment": { "Variables": { "TABLE_NAME": { "Ref": "OptOuts" }, "ADMIN_SECRET_ARN": { "Ref": "OperatorSecret" } } }
      }
    },
    "Url": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": { "Ref": "Function" },
        "AuthType": "NONE",
        "Cors": { "AllowOrigins": ["https://siliciumveritas.com", "https://www.siliciumveritas.com"], "AllowMethods": ["POST"], "AllowHeaders": ["content-type"], "MaxAge": 600 }
      }
    },
    "UrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": { "FunctionName": { "Ref": "Function" }, "Action": "lambda:InvokeFunctionUrl", "Principal": "*", "FunctionUrlAuthType": "NONE" }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": { "FunctionName": { "Ref": "Function" }, "Action": "lambda:InvokeFunction", "Principal": "*", "InvokedViaFunctionUrl": true }
    }
  },
  "Outputs": {
    "ApiUrl": { "Value": { "Fn::GetAtt": ["Url", "FunctionUrl"] } },
    "SecretArn": { "Value": { "Ref": "OperatorSecret" } },
    "TableName": { "Value": { "Ref": "OptOuts" } }
  }
}
